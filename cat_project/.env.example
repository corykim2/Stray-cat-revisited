# ============================================================
# 환경변수 명세
#
# 이 파일을 .env 로 복사한 뒤 값을 채워 사용합니다.
#   cp .env.example .env          (Linux/Mac)
#   Copy-Item .env.example .env   (Windows)
#
# .env 는 절대 커밋하지 않습니다. 이 파일만 커밋합니다.
# 실행: docker run --env-file .env -p 8000:8000 straycat
# ============================================================


# ── 필수 ────────────────────────────────────────────────────

# Django 서명 키 (세션/CSRF 토큰 서명에 사용)
# 환경마다 다른 값을 쓰고, 절대 공유하지 않습니다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 디버그 모드. 'True' 일 때만 켜집니다. (문자열 비교)
# 운영에서 True 로 두면 에러 페이지에 소스코드와 설정값이 그대로 노출됩니다.
#   로컬:   True
#   서버:   False
DJANGO_DEBUG=False

# 접속을 허용할 호스트. 쉼표로 구분, 스킴(http://) 없이 적습니다.
# DEBUG=False 인데 비어 있으면 모든 요청이 400 으로 거부됩니다.
#   로컬:   localhost,127.0.0.1
#   서버:   13.125.0.0            (EC2 퍼블릭 IP 또는 도메인)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# ── 배포 시 필요 ────────────────────────────────────────────

# POST 요청(로그인/글쓰기/사진 업로드)을 허용할 출처.
# ALLOWED_HOSTS 와 달리 스킴과 포트까지 정확히 적어야 합니다.
# 비워두면 배포 후 페이지는 뜨는데 로그인만 403 이 납니다.
#   로컬:   (비워둠 - localhost 는 자동 허용)
#   서버:   http://13.125.0.0:8000
DJANGO_CSRF_ORIGINS=


# ── 데이터 보관 위치 (컨테이너 재시작 시 소멸 방지) ─────────

# SQLite 파일 경로. 기본값은 앱 폴더 안이라 컨테이너와 함께 사라집니다.
# 볼륨을 마운트한 경로를 지정하세요.
#   로컬:   (비워둠 - BASE_DIR/db.sqlite3)
#   서버:   /data/db.sqlite3
DJANGO_DB_PATH=

# 사용자가 업로드한 사진 저장 위치. 위와 같은 이유로 분리 대상입니다.
#   로컬:   (비워둠 - BASE_DIR/media)
#   서버:   /data/media
DJANGO_MEDIA_ROOT=

# 카카오맵 JavaScript 키
# 콘솔에서 사이트 도메인 등록 필수 (미등록 시 키가 유효해도 동작 안 함)
#   로컬: http://localhost:8000
#   서버: http://34.64.231.102:8000
KAKAO_JS_KEY=