# ============================================================
# 환경변수 명세
#
# 이 파일을 .env 로 복사한 뒤 값을 채워 사용합니다.
#   cp .env.example .env          (Linux/Mac)
#   Copy-Item .env.example .env   (Windows)
#
# .env 는 절대 커밋하지 않습니다. 이 파일만 커밋합니다.
# 실행: docker run --env-file .env -v straycat-data:/data -p 8000:8000 straycat
# ============================================================


# ── 필수 ────────────────────────────────────────────────────

# Django 서명 키 (세션/CSRF 토큰 서명에 사용)
# 환경마다 다른 값을 쓰고, 절대 공유하지 않습니다.
# 생성: docker run --rm straycat python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 디버그 모드. 'True' 일 때만 켜집니다. (문자열 비교)
# 운영에서 True 로 두면 에러 페이지에 소스코드와 URL 구조가 그대로 노출됩니다.
#   로컬:   True
#   서버:   False
DJANGO_DEBUG=False

# 접속을 허용할 호스트. 쉼표 구분, 스킴(http://) 없이.
# DEBUG=False 인데 비어 있으면 모든 요청이 400 으로 거부됩니다.
#   로컬:   localhost,127.0.0.1
#   서버:   34.64.231.102
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# ── 배포 시 필요 ────────────────────────────────────────────

# POST 요청(로그인/글쓰기/사진 업로드)을 허용할 출처.
# ALLOWED_HOSTS 와 달리 스킴과 포트까지 정확히 적어야 합니다.
# 비워두면 배포 후 페이지는 뜨는데 로그인만 403 이 납니다.
#   로컬:   (비워둠 - localhost 는 자동 허용)
#   서버:   http://34.64.231.102:8000
DJANGO_CSRF_ORIGINS=


# ── 외부 서비스 ─────────────────────────────────────────────

# 카카오맵 JavaScript 키.
# 키가 유효해도, 콘솔에서 '사이트 도메인'을 등록하지 않으면 동작하지 않습니다.
#   developers.kakao.com > 앱 설정 > 플랫폼 > Web > 사이트 도메인
#   등록: http://localhost:8000 , http://34.64.231.102:8000
KAKAO_JS_KEY=


# ── 데이터 보관 위치 (Docker Volume) ────────────────────────
# 컨테이너를 재생성해도 데이터가 유지되도록, 볼륨(/data)에 저장합니다.
# 실행 시 -v straycat-data:/data 로 볼륨을 연결해야 합니다.

# SQLite 파일 경로. 기본값은 앱 폴더 안이라 컨테이너와 함께 사라집니다.
#   로컬/서버 공통: /data/db.sqlite3
DJANGO_DB_PATH=/data/db.sqlite3

# 업로드 사진 저장 위치. 위와 같은 이유로 볼륨 안에 둡니다.
#   로컬/서버 공통: /data/media
DJANGO_MEDIA_ROOT=/data/media